# ===================================================================
# FASTAPI BACKEND CONFIGURATION
# Copy this file to backend/.env and populate your actual credentials.
# NEVER commit the actual .env file to Git/GitHub!
# ===================================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ===================================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# ===================================================================
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key here ONLY on the backend.
# The service role key has admin rights to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key
# Bucket name for resume files in Supabase Storage
SUPABASE_STORAGE_BUCKET=resumes

# ===================================================================
# OPENAI / LLM API CONFIGURATION
# Found in: https://platform.openai.com/api-keys
# ===================================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ===================================================================
# COMPATIBILITY SCORING WEIGHTS (Must sum to 1.00)
# ===================================================================
WEIGHT_REQUIRED_SKILLS=0.60
WEIGHT_PREFERRED_SKILLS=0.15
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
